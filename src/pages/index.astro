import GlobalLayout from '../layouts/GlobalLayout.astro'
import PageHeader from '../components/PageHeader.astro'
import Section from '../components/Section.astro'

const birthDate = new Date('2002-05-30')
const today = new Date()
const dMonths = today.getUTCMonth() - birthDate.getUTCMonth()
const dDays = today.getUTCDate() - birthDate.getUTCDate()
const dYears = today.getUTCFullYear() - birthDate.getUTCFullYear()
const age = dYears - +(dMonths < 0 || (dMonths === 0 && dDays < 0))

const descriptions = [
	// catgirl who...
	'meows and sleeps',
	'bites and scwatches',
	'eats cookies',
	'drinks coffee',
	'sometimes writes code',
	'lives the night',
	'fears people',
	'uses arch btw',
	'purrs when headpatted',
]
