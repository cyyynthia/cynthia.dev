import Skeleton from '../../layouts/Skeleton.astro'
import Section from '../../components/Section.astro'

import arrowLeftSvg from 'feather-icons/dist/icons/arrow-left.svg?raw'
---
<Skeleton title="No Generative AI - cynthia's website" robots-hidden>
	<main id="page-contents">
		<a href="/" class="www-link">
			<Fragment set:html={arrowLeftSvg}/>
			<span>Go to cynthia.dev</span>
		</a>

		<div class="big-heading">
			<h1>
				<span class="no-break">Made <span class="no">without</span></span>
				<span class="no-break">Generative AI</span>
			</h1>
		</div>
		<Section class="statement">
			While many have turned to AI generated slop, I will <b>never</b> sacrifice the <u>quality</u>,
			<u>originality</u>, and <u>creativity</u> of my work.
		</Section>

		<hr/>

		<Section>
			Generative AI has been built by stealing <b>billions</b> of hours of work from artists fueled by
			<b>passion</b> and <b>dedication</b>, fueling it into a <b>predatory</b> tool driven by <b>profit</b>
			rather than <b>ethics</b>.
		</Section>
	</main>
</Skeleton>

<style>
	main#page-contents {
		text-transform: initial;
		font-size: 1.2rem;
		width: 55vw;
	}

	.www-link {
		display: flex;
		align-items: center;
		gap: .25rem;

		background: none;
		text-transform: lowercase;
		font-size: .9rem;
		margin: 1.5rem 0 2rem;
	}

	.www-link :global(svg) {
		width: 1em;
		height: 1em;
		margin-top: .2em;
		transition: transform .5s;
	}

	.www-link:hover {
		text-decoration: underline;
	}

	.www-link:hover :global(svg) {
		transform: translateX(-25%);
	}

	.no-break {
		text-wrap: nowrap;
	}

	.big-heading {
		font-size: 4rem;
		line-height: 1;
		color: var(--header-color);
		font-weight: 300;

		text-align: center;
		margin: 0 -10vw 2rem;
	}

	.big-heading h1 {
		all: unset;
	}

	.big-heading .no, .statement u {
		text-decoration: underline;
		text-decoration-thickness: .125rem;
		text-underline-offset: .25rem;
	}

	.statement {
		font-size: 2rem;
		text-align: center;
		text-wrap: balance;
		font-weight: 300;
		line-height: 1.2;
		margin: 0;
	}

	hr {
		margin: 3.5rem 0;
	}

	sup {
		font-size: .75rem;
		line-height: .5;
		background: none;
		position: relative;
		top: -.1rem;
	}
</style>
