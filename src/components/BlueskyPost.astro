---
// Component originally written by Mary
// https://github.com/mary-ext/bluesky-embed-astro/blob/trunk/src/components/BlueskyPost.astro

import { fetchPost, renderPost } from 'bluesky-post-embed/core'

interface Props {
	uri: string;
}

const { uri } = Astro.props

const data = await fetchPost({ uri })
const render = renderPost(data)
---
<bluesky-post src={data.thread?.post.uri}>
	<Fragment set:html={render} />
</bluesky-post>

<style is:global>
	@import 'bluesky-post-embed/style.css';
	@import 'bluesky-post-embed/themes/light.css' (prefers-color-scheme: light);
	@import 'bluesky-post-embed/themes/dim.css' (prefers-color-scheme: dark);

	bluesky-post {
		display: block;
		text-align: left;
	}

	bluesky-post a {
		background: none;
	}
</style>

<script>
	import 'bluesky-post-embed'
</script>
