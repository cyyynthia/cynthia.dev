import penToolSvg from 'feather-icons/dist/icons/pen-tool.svg?raw'

export interface Props {
	src: ImageMetadata
	alt: string
	caption?: string
	invertible?: boolean
}

---
<div class="affiliation-notice">
	<Fragment class="icon" aria-hidden="true" set:html={penToolSvg} />
	<div class="text">
		<slot />
	</div>
</div>

<style>
	.affiliation-notice {
		display: flex;
		gap: .75rem;
		padding: .75rem 1rem;
		background-color: #83c7fc;
		border-radius: .5rem;
		font-size: .875rem;
		margin-bottom: 2rem;
	}

	.affiliation-notice .text :global(p) {
		line-height: 1.25;
	}

	.affiliation-notice .text :global(details) {
		margin-top: 0.5rem;
	}

	.affiliation-notice .text :global(summary) {
		cursor: pointer;
	}

	.affiliation-notice .text :global(details[open] summary) {
		margin-bottom: 0.25em;
	}

	.affiliation-notice :global(svg) {
		flex-shrink: 0;
		width: 1em;
		height: 1em;
		margin-top: .25em;
	}

	@media (prefers-color-scheme: dark) {
		.affiliation-notice {
			background-color: #005daf;
			color: white;
		}
	}
</style>
