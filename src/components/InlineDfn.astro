const defaultSlot = Astro.slots.render("default").then((h) => h.trim())
const dfnSlot = Astro.slots.render("dfn").then((h) => h.trim())
const { class: cn, ...rest } = Astro.props
---
<span {...rest} class:list={[cn, "dfn-wrapper"]}
	><span class="dfn-content"><Fragment set:html={defaultSlot} /></span
	><span class="sr-only dfn"
		><span class="sr-only">(</span><Fragment set:html={dfnSlot} /><span class="sr-only">)</span
	></span
></span

><style>
	.dfn-wrapper {
		position: relative;
	}

	.dfn-wrapper:not(.no-underline) .dfn-content {
		text-decoration: underline dashed;
	}

	.dfn-wrapper:hover::before {
		content: '';
		display: block;
		position: absolute;
		z-index: 10;
		inset: 0;
		bottom: -0.5rem;
	}

	.dfn-wrapper:hover .dfn {
		all: unset;
		display: block;
		position: absolute;
		box-shadow: 0 2px 16px 2px rgba(0,0,0,0.5);
		background-color: var(--background-secondary-color);
		border: 1px var(--border-color) solid;
		width: max-content;
		padding: 0.75em 1em;
		max-width: 350px;
		bottom: -0.5em;
		left: 50%;
		transform: translate(-50%, 100%);
		z-index: 9999;
	}

	.dfn-wrapper.small:hover .dfn {
		padding: 0.25em 0.5em;
	}

	.dfn-wrapper:hover .dfn::before {
		content: '';
		display: block;
		width: 0.75em;
		height: 0.75em;
		background-color: inherit;
		transform: translate(-50%, -50%) rotate(45deg);
		position: absolute;
		top: 0;
		left: 50%;
	}
</style>
