import { ClientRouter } from 'astro:transitions'
import socialImage from '../assets/social-image.png'

export interface Props {
	title: string
	bodyClass?: string
	description?: string
	robotsHidden?: boolean
}

const { title, description: d, robotsHidden, bodyClass: className } = Astro.props
const canonicalUrl = new URL(Astro.url.pathname, Astro.site)
const socialImageUrl = new URL(socialImage.src, Astro.site)
const description = d || 'meow meow meow meow meow meow'
---
<html lang="en">
	<head>
		<meta charset="utf8" />
		<meta name="theme-color" content="#f49898" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="shortcut icon" href="/favicon.ico" />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />

		<meta property="og:site_name" content="cynthia.dev" />
		<meta property="og:type" content="website">
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={socialImageUrl} />

		<meta name="twitter:card" content="summary" />
		<meta name="twitter:site" content="@cyyynthia_" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageUrl} />

		{robotsHidden && <meta name="robots" content="noindex, nofollow" />}
		<link rel="sitemap" href="/sitemap-index.xml" />
		<slot name="head" />
		<ClientRouter />
	</head>
	<body class={className}>
		<slot />
	</body>
</html>
