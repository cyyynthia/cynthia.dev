import Skeleton from './Skeleton.astro'

export interface Props {
	title: string
	class?: string
	description?: string
	robotsHidden?: boolean
}

// const { ,...props } = Astro.props
---
<Skeleton {...Astro.props}>
	<div class="markdown-container">
		<slot />
	</div>
</Skeleton>

<style is:global>
	@font-face {
		font-family: 'JetBrains Mono';
		font-style: normal;
		font-display: swap;
		src: url(../assets/fonts/jetbrains-mono-regular.woff2) format('woff2');
	}

	/* @formatter:off */
	* { box-sizing: border-box }
	/* @formatter:on */

	html, body {
		margin: 0;
		padding: 0;
		width: 100%;
		height: 100%;
		font-size: 14px;
		font-family: "JetBrains Mono", monospace;
		text-rendering: optimizeLegibility;
		line-height: 1.25;
	}

	:root {
		--spacing: 1.25rem;
	}

	.markdown-container {
		max-width: 70ch;
		margin: 0 auto;
	}

	/* Headers */
	h1, h2, h3, h4, h5, h6 {
		font-size: 14px;
		font-weight: bold;
		margin: var(--spacing) 0;
	}

	:is(h1, h2, h3, h4, h5, h6)::before {
		content: '# ';
		color: dimgray;
	}

	/* @formatter:off */
	h1::before { content: '# ' }
	h2::before { content: '## ' }
	h3::before { content: '### ' }
	h4::before { content: '#### ' }
	h5::before { content: '##### ' }
	h6::before { content: '###### ' }
	/* @formatter:on */

	/* Paragraphs */
	p {
		margin: var(--spacing) 0;
	}

	ul {
		list-style-type: '- ';
		margin: var(--spacing) 0;
		padding-inline-start: 2ch;
	}

	ul ul {
		margin: 0;
	}

	::marker {
		color: dimgray;
	}
</style>
